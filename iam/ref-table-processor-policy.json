{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadCloudTrailLogs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::{log-archive-bucket}/AWSLogs/*"
    },
    {
      "Sid": "DynamoDBWriteRefTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:{region}:{account-id}:table/ref_error_event",
        "arn:aws:dynamodb:{region}:{account-id}:table/ref_ip_country",
        "arn:aws:dynamodb:{region}:{account-id}:table/ref_aws_api",
        "arn:aws:dynamodb:{region}:{account-id}:table/ref_region",
        "arn:aws:dynamodb:{region}:{account-id}:table/ref_user_agent"
      ]
    },
    {
      "Sid": "FirehosePutRecord",
      "Effect": "Allow",
      "Action": "firehose:PutRecord",
      "Resource": [
        "arn:aws:firehose:{region}:{account-id}:deliverystream/ref-error-event-stream",
        "arn:aws:firehose:{region}:{account-id}:deliverystream/ref-ip-country-stream",
        "arn:aws:firehose:{region}:{account-id}:deliverystream/ref-aws-api-stream",
        "arn:aws:firehose:{region}:{account-id}:deliverystream/ref-region-stream",
        "arn:aws:firehose:{region}:{account-id}:deliverystream/ref-user-agent-stream"
      ]
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:{region}:{account-id}:log-group:/aws/lambda/ref-table-processor:*"
    }
  ]
}
